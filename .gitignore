# Generated by the azure role (contains the storage account access key)
inventories/**/group_vars/all/azure_vip.yml
inventories/**/group_vars/_postgres/wal-g.yml
inventories/**/group_vars/_postgres/proxy.yml

# Azure credentials written by scripts/az_to_env
azure_creds.env

# Created by vagrant up (platforms/vagrant/Vagrantfile): the shared ssh key of the boxes, and the vagrant state
platforms/vagrant/.ssh/
platforms/vagrant/.vagrant/

# Roles from requirements.yml, when ansible-galaxy installs them here (roles_path in ansible.cfg)
roles/pgvillage.*/

# mkdocs build output, and its cache: the privacy plugin's assets and the roles of the role reference
# (docs/scripts/role_reference.py installs them in .cache/role-reference/)
site/
.cache/
