---
# Groups used by PgVillage. Hosts are added by the platform inventory
# (e.g. inventories/azure); use with an OS layer: -i inventories/standard -i inventories/<os> -i inventories/<platform>
all:
  children:
    localhosts:
    backup:
    hacluster:
    # The standard architecture: stolon and etcd run on the database hosts
    stolon:
      children:
        hacluster:
    etcd_master:
      children:
        hacluster:
