---
# Groups used by PgVillage. Hosts are added by the platform inventory
# (e.g. inventories/platform/azure); use with an OS layer:
# -i inventories/standard -i inventories/os/<os> -i inventories/platform/<platform>
all:
  children:
    localhosts:
    backup:
    hacluster:
    # The standard architecture: stolon and etcd run on the database hosts
    stolon:
      children:
        hacluster:
    etcd_master:
      children:
        hacluster:
    # The router (haproxy, keepalived, pgroute66) and its VIP. The platform inventory adds the hosts (e.g. the database
    # hosts, as in inventories/platform/vagrant), as the VIP (keepalived_vip) depends on the platform's network.
    router:
    # Hosts that get the HAProxy checks of nagios (usually the router hosts)
    haproxy:
