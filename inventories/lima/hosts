---
# Use on top of standard and the OS of the VMs: -i inventories/standard -i inventories/ubuntu (or el) -i inventories/lima
# The VMs of lima/up.sh, by their names on the lima user-v2 network (lima-<instance>.internal). Their addresses come
# from DHCP, so there is no ansible_host: standard takes the addresses from the facts.
all:
  children:
    hacluster:
      hosts:
        lima-pgv-db-1.internal:
        lima-pgv-db-2.internal:
        lima-pgv-db-3.internal:
    backup:
      hosts:
        lima-pgv-backup.internal:
    # The router (haproxy, keepalived, pgroute66) runs on the database hosts (stolon and etcd too, see standard)
    router:
      children:
        hacluster:
    haproxy:
      children:
        hacluster:
    localhosts:
      hosts:
        # Defined here (not in standard), so inventory_dir and cluster_name are those of this inventory
        localhost:
           ansible_connection: local
           ansible_python_interpreter: "{{ansible_playbook_python}}"
