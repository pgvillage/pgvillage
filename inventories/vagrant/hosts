---
# Use on top of standard and the OS of the boxes: -i inventories/standard -i inventories/ubuntu (or el, suse) -i inventories/vagrant
all:
  children:
    hacluster:
      hosts:
        db-1.local:
          ansible_host: 172.30.1.31
        db-2.local:
          ansible_host: 172.30.1.32
        db-3.local:
          ansible_host: 172.30.1.33
    backup:
      hosts:
        minio.local:
          ansible_host: 172.30.1.20
    # stolon, etcd and the router (haproxy, keepalived, pgroute66) all run on the database hosts
    stolon:
      children:
        hacluster:
    etcd_master:
      children:
        hacluster:
    router:
      children:
        hacluster:
    haproxy:
      children:
        hacluster:
    localhosts:
      hosts:
        # Defined here (not in standard), so inventory_dir and cluster_name are those of this inventory
        localhost:
           ansible_connection: local
           ansible_python_interpreter: "{{ansible_playbook_python}}"
  vars:
    ansible_user: vagrant
