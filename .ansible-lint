---
# The roles from requirements.yml, when ansible-galaxy installs them in ./roles (roles_path in ansible.cfg): they are
# linted in their own repos
exclude_paths:
  - roles/pgvillage.*/
  # The roles that the docs build installs for the role reference (docs/scripts/role_reference.py)
  - .cache/role-reference/
# The Azure playbooks need azure.azcollection, which only the Azure bootstrap scripts install (with its Python
# requirements), not requirements.yml: mock its modules for the syntax check
mock_modules:
  - azure.azcollection.azure_rm_loadbalancer
  - azure.azcollection.azure_rm_publicipaddress
  - azure.azcollection.azure_rm_publicipaddress_info
  - azure.azcollection.azure_rm_resourcegroup
  - azure.azcollection.azure_rm_securitygroup
  - azure.azcollection.azure_rm_storageaccount
  - azure.azcollection.azure_rm_storageaccount_info
  - azure.azcollection.azure_rm_storageblob
  - azure.azcollection.azure_rm_subnet
  - azure.azcollection.azure_rm_virtualmachine
  - azure.azcollection.azure_rm_virtualmachinescaleset
  - azure.azcollection.azure_rm_virtualnetwork
